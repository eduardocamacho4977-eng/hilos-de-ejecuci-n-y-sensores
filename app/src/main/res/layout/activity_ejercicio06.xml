<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 6: Sensor Simulado con Corrutinas"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btnIniciarSim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar Simulación de Sensor" />

    <Button
        android:id="@+id/btnDetenerSim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Detener Simulación"
        android:enabled="false" />

    <TextView
        android:id="@+id/tvValorSensor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Valor Sensor: ---"
        android:textSize="24sp"
        android:textStyle="bold" />

</LinearLayout>