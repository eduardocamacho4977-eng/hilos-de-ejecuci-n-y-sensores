<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 3: Ejecución de 3 Hilos Simultáneos"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btnEjecutar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejecutar Hilos de Pares, Impares y Letras" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tvSalida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Presiona el botón para ejecutar los 3 hilos..."
            android:textSize="16sp" />
    </ScrollView>

</LinearLayout>